	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="crbase" />
		<Option pch_mode="2" />
		<Option compiler="gcc-mingw64" />
		<Build>
			<Target title="Debug_x64">
				<Option output="$(WORKSPACE_DIR)/out/bin/Debug_x64/crbase" prefix_auto="1" extension_auto="1" />
				<Option object_output="$(WORKSPACE_DIR)/out/obj/crbase/Debug_x64/" />
				<Option type="1" />
				<Option compiler="gcc-mingw64" />
				<Compiler>
					<Add option="-std=gnu++11" />
					<Add option="-m64" />
					<Add option="-ggdb" />
					<Add option="-g" />
					<Add directory="../../../src/" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add library="winmm" />
					<Add library="shlwapi" />
					<Add library="version" />
					<Add library="ole32" />
				</Linker>
			</Target>
			<Target title="Release_x64">
				<Option output="$(WORKSPACE_DIR)/out/bin/Release_x64/crbase" prefix_auto="1" extension_auto="1" />
