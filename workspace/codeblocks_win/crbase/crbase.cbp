				<Option type="1" />
				<Option compiler="gcc-mingw64" />
				<Compiler>
					<Add option="-Os" />
					<Add option="-std=gnu++11" />
					<Add option="-m64" />
					<Add directory="../../../src/" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add library="winmm" />
					<Add library="shlwapi" />
					<Add library="version" />
					<Add library="ole32" />
				</Linker>
			</Target>
			<Target title="Debug_x86">
