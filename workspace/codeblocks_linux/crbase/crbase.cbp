	<Project>
		<Option title="crbase" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug_x64">
				<Option output="$(WORKSPACE_DIR)/out/bin/Debug_x64/crbase" prefix_auto="1" extension_auto="1" />
				<Option object_output="$(WORKSPACE_DIR)/out/obj/crbase/Debug_x64/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-std=c++11" />
					<Add option="-m64" />
					<Add option="-g" />
					<Add directory="../../../src/" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add library="pthread" />
				</Linker>
			</Target>
			<Target title="Release_x64">
				<Option output="$(WORKSPACE_DIR)/out/bin/Release_x64/crbase" prefix_auto="1" extension_auto="1" />
				<Option object_output="$(WORKSPACE_DIR)/out/obj/crbase/Release_x64/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-m64" />
					<Add directory="../../../src/" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-m64" />
					<Add library="pthread" />
				</Linker>
			</Target>
			<Target title="Debug_x86">
				<Option output="$(WORKSPACE_DIR)/out/bin/Debug_x86/crbase" prefix_auto="1" extension_auto="1" />
				<Option object_output="$(WORKSPACE_DIR)/out/obj/crbase/Debug_x86/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-std=c++11" />
					<Add option="-m32" />
					<Add option="-g" />
					<Add directory="../../../src/" />
				</Compiler>
				<Linker>
					<Add option="-m32" />
					<Add library="pthread" />
				</Linker>
			</Target>
			<Target title="Release_x86">
				<Option output="$(WORKSPACE_DIR)/out/bin/Release_x86/crbase" prefix_auto="1" extension_auto="1" />
				<Option object_output="$(WORKSPACE_DIR)/out/obj/crbase/Release_x86/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
